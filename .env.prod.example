# Copy to .env.prod on the server (never commit .env.prod).
# Run: docker compose --env-file .env.prod -f compose.prod.yaml up -d --build

# --- Database ---
POSTGRES_PASSWORD=password
DATABASE_URL=postgresql+asyncpg://postgres:password@db:5432/ai_assistant

# --- Auth ---
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
COOKIE_SECURE=true
CORS_ORIGINS=["https://app.ansenbey.com"]

# --- AI ---
ANTHROPIC_API_KEY=
VOYAGE_API_KEY=

# --- Web Push (copy from Render - never change) ---
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_SUBJECT=

# --- Optional ---
LOG_LEVEL=INFO
DEBUG=false
