# Copy to .env.prod on the server (never commit .env.prod).
# Run: docker compose --env-file .env.prod -f compose.prod.yaml up -d --build

POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+asyncpg://postgres:change-me@db:5432/ai_assistant

COOKIE_SECURE=true
CORS_ORIGINS=["https://app.ansenbey.com"]

ANTHROPIC_API_KEY=
VOYAGE_API_KEY=

# Copy from Render - never change (existing push subscriptions depend on them)
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_SUBJECT=

JWT_SECRET_KEY=
